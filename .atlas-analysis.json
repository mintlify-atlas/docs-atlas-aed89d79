  "keyFeatures": [
    "Userspace verbs interface (libibverbs) for direct RDMA hardware access",
    "Connection management library (librdmacm) for RDMA connections",
    "Python bindings (pyverbs) for scripting and testing",
    "Hardware provider plugins for 18+ RDMA/InfiniBand NICs",
    "Software RDMA emulation via Soft-RoCE (RXE) and SoftIWARP (SIW)",
    "InfiniBand diagnostic tools (infiniband-diags)",
    "Communication manager daemon (ibacm) for address and route resolution",
    "SRP daemon for InfiniBand SCSI RDMA Protocol targets",
    "iWARP port mapper daemon (iwpmd)"
  ],
  "publicApiSurface": [
